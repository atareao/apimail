# apimail — Configuración de entorno
# Plantilla Jinja2: renderízala a `.env` (o cópiala rellenando los valores)
# para configurar el contenedor. Compose la lee automáticamente.

# ── API ───────────────────────────────────────
# Clave estática exigida en cada petición. Fail-closed: sin un valor no vacío
# el proceso aborta en el arranque.
APIMAIL_API_KEY={{ apimail_api_key }}
APIMAIL_HOST=0.0.0.0
APIMAIL_PORT=3000

# ── Cuenta IMAP ───────────────────────────────
# HOST, USER y PASSWORD son obligatorios; PORT y TLS son opcionales.
APIMAIL_IMAP_HOST={{ apimail_imap_host }}
APIMAIL_IMAP_USER={{ apimail_imap_user }}
APIMAIL_IMAP_PASSWORD={{ apimail_imap_password }}
# Puerto del servidor IMAP. Si se deja sin valor se deriva del modo TLS
# (993 con implicit, 143 con starttls/none).
# APIMAIL_IMAP_PORT=993
# Modo TLS: implicit (por defecto), starttls o none.
# APIMAIL_IMAP_TLS=implicit
# Timeout (segundos) de conexión, handshake TLS y login IMAP.
# APIMAIL_IMAP_TIMEOUT_SECS=30

# ── Cuenta SMTP ───────────────────────────────
# HOST, USER y PASSWORD son obligatorios; PORT y TLS son opcionales.
APIMAIL_SMTP_HOST={{ apimail_smtp_host }}
APIMAIL_SMTP_USER={{ apimail_smtp_user }}
APIMAIL_SMTP_PASSWORD={{ apimail_smtp_password }}
# Puerto del servidor SMTP. Si se deja sin valor se deriva del modo TLS
# (465 con implicit, 587 con starttls/none).
# APIMAIL_SMTP_PORT=465
# Modo TLS: implicit (por defecto), starttls o none.
# APIMAIL_SMTP_TLS=implicit

# ── Límites de parseo ─────────────────────────
# Tamaño máximo, en bytes, de los adjuntos decodificados de un mensaje (10 MiB).
# APIMAIL_MAX_ATTACHMENT_BYTES=10485760
# Tamaño máximo, en bytes, de un mensaje que se descarga y parsea (25 MiB).
# APIMAIL_MAX_MESSAGE_BYTES=26214400

# ── IDLE y webhook ────────────────────────────
# URL a la que se notifica cada correo nuevo. Sin ella la suscripción IDLE NO
# arranca (queda deshabilitada).
APIMAIL_WEBHOOK_URL={{ apimail_webhook_url }}
# Buzón vigilado por la suscripción IDLE (por defecto INBOX).
# APIMAIL_IDLE_MAILBOX=INBOX
# Timeout (segundos) de cada petición al webhook.
# APIMAIL_WEBHOOK_TIMEOUT_SECS=10

# ── Cola durable del webhook ──────────────────
# En el contenedor Compose ya define APIMAIL_QUEUE_PATH=/app/data/queue.jsonl:
# la entrega es at-least-once y lo encolado sobrevive a recrear el contenedor.
# Descomentar la línea de abajo sirve solo para cambiar la ruta del fichero.
# Para volver a la cola en memoria (se pierde al recrear el contenedor) deja
# APIMAIL_QUEUE_PATH= en blanco: un valor vacío equivale a ausencia.
# APIMAIL_QUEUE_PATH=/app/data/queue.jsonl
# Máximo de notificaciones pendientes en la cola.
# APIMAIL_QUEUE_MAX_ITEMS=1000
# Máximo de bytes vivos en la cola (64 MiB).
# APIMAIL_QUEUE_MAX_BYTES=67108864

# ── Servidor MCP (opt-in) ─────────────────────
# Solo tienen efecto en un binario compilado CON la feature `mcp`
# (`cargo build --features mcp`); la imagen publicada se construye sin ella. Son
# fail-closed: descomentar cualquiera de las tres en un build sin la feature hace
# que el proceso aborte al arrancar nombrando la variable. Deben quedar
# comentadas si no se sirve MCP. `stdio` y `http` son mutuamente excluyentes: un
# proceso sirve UN transporte (ponerlas a `true` a la vez aborta el arranque).
# Sirve MCP por entrada/salida estándar (el cliente lanza el binario; no abre
# puerto).
# APIMAIL_MCP_STDIO=false
# Sirve MCP por Streamable HTTP, anidado en el mismo listener que la API (no abre
# puerto) y con la misma cabecera `Authorization: Bearer <APIMAIL_API_KEY>`.
# APIMAIL_MCP_HTTP=false
# Ruta del transporte HTTP: absoluta, distinta de `/` y fuera del prefijo
# reservado `/api`.
# APIMAIL_MCP_PATH=/mcp
# Nota: Compose pasa al contenedor una lista explícita de variables (ver
# compose.yml), así que las tres de arriba solo llegan al contenedor si se
# añaden a esa lista.

# ── Publicación (solo Compose) ────────────────
# Puerto del host al que se publica el 3000 interno del contenedor.
APIMAIL_PUBLISHED_PORT=3000

# ── Logging ───────────────────────────────────
# RUST_LOG no se lee hoy: el binario fija el nivel en INFO, así que definirla no tiene efecto.
